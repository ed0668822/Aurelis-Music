<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aurelis_discord_oauth.xml" />
        <exclude domain="sharedpref" path="aurelis_auth.xml" />
        <exclude domain="sharedpref" path="aurelis_auth_plain.xml" />
        <exclude domain="sharedpref" path="aurelis_sources.xml" />
        <exclude domain="sharedpref" path="aurelis_sources_plain.xml" />
        <!-- Tester code: a credential for this phone's owner (see AddonAuth). -->
        <exclude domain="sharedpref" path="aurelis_tester.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="aurelis_last_played.xml" />
        <exclude domain="sharedpref" path="aurelis_bounded_context.xml" />
        <exclude domain="sharedpref" path="aurelis_party_queue_stash.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aurelis_discord_oauth.xml" />
        <exclude domain="sharedpref" path="aurelis_auth.xml" />
        <exclude domain="sharedpref" path="aurelis_auth_plain.xml" />
        <exclude domain="sharedpref" path="aurelis_sources.xml" />
        <exclude domain="sharedpref" path="aurelis_sources_plain.xml" />
        <!-- Tester code: a credential for this phone's owner (see AddonAuth). -->
        <exclude domain="sharedpref" path="aurelis_tester.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="aurelis_last_played.xml" />
        <exclude domain="sharedpref" path="aurelis_bounded_context.xml" />
        <exclude domain="sharedpref" path="aurelis_party_queue_stash.xml" />
    </device-transfer>
</data-extraction-rules>
